{
  "name": "git-temp-auth",
  "version": "1.0.0",
  "description": "GitHub App 短期凭证签发工具 —— 换取 1 小时有效的安装访问令牌（Bun / Windows 版）",
  "type": "module",
  "scripts": {
    "app": "bun gh-app-token.ts",
    "app:check": "bun gh-app-token.ts --check",
    "app:json": "bun gh-app-token.ts --json",
    "app:no-clipboard": "bun gh-app-token.ts --no-clipboard",
    "app:no-net": "bun gh-app-token.ts --no-net",

    "build": "bun build ./gh-app-token.ts --compile --outfile dist/gh-app-token.exe",
    "build:min": "bun build ./gh-app-token.ts --compile --minify --outfile dist/gh-app-token.exe",
    "deploy": "bun build ./gh-app-token.ts --compile --outfile dist-app/gh-app-token.exe && cp .env dist-app/.env && cp app-private-key.pem dist-app/app-private-key.pem",

    "typecheck": "tsc --noEmit --strict --skipLibCheck --types node gh-app-token.ts"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  }
}
